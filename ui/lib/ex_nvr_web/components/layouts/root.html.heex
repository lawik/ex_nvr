<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <head>
      {Application.get_env(:live_debugger, :live_debugger_tags)}
    </head>
    <script>
      // Init dark mode, having this script here so the initial page flicker from light to dark won't be noticeable
      if (localStorage.getItem('dark-mode') === 'true' || (!('dark-mode' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
    <.live_title suffix=" · Network Video Recorder">
      {assigns[:page_title] || "ExNVR"}
    </.live_title>
    <LiveVue.Reload.vite_assets assets={["/js/app.js", "/css/app.css"]}>
      <link phx-track-static rel="stylesheet" href={static_path(@conn, "/assets/app.css")} />
      <script defer phx-track-static type="module" src={static_path(@conn, "/assets/app.js")} />
    </LiveVue.Reload.vite_assets>
    <style>
      /* ── Style 1: Corner Brackets ── */
      .bbox-corners {
        position: absolute;
        --c: #00e5cc;
        --len: 14px;
        --w: 2px;
      }
      .bbox-corners::before,
      .bbox-corners::after,
      .bbox-corners-bl::before,
      .bbox-corners-bl::after {
        content: '';
        position: absolute;
        background: var(--c);
        border-radius: 1px;
      }
      .bbox-corners::before { top: 0; left: 0; width: var(--len); height: var(--w); }
      .bbox-corners::after  { top: 0; left: 0; width: var(--w); height: var(--len); }
      .bbox-corners-tr { position: absolute; top: 0; right: 0; }
      .bbox-corners-tr::before { content:''; position:absolute; top:0; right:0; width:var(--len); height:var(--w); background:var(--c); border-radius:1px; }
      .bbox-corners-tr::after  { content:''; position:absolute; top:0; right:0; width:var(--w); height:var(--len); background:var(--c); border-radius:1px; }
      .bbox-corners-bl { position: absolute; bottom: 0; left: 0; }
      .bbox-corners-bl::before { bottom: 0; left: 0; width: var(--len); height: var(--w); }
      .bbox-corners-bl::after  { bottom: 0; left: 0; width: var(--w); height: var(--len); }
      .bbox-corners-br { position: absolute; bottom: 0; right: 0; }
      .bbox-corners-br::before { content:''; position:absolute; bottom:0; right:0; width:var(--len); height:var(--w); background:var(--c); border-radius:1px; }
      .bbox-corners-br::after  { content:''; position:absolute; bottom:0; right:0; width:var(--w); height:var(--len); background:var(--c); border-radius:1px; }
      .bbox-corners-fill {
        position: absolute; inset: 0;
        background: var(--c);
        opacity: 0.04;
      }
      .bbox-corners-tag {
        position: absolute;
        top: -28px; left: 0;
        background: var(--c);
        color: #000;
        font-family: 'DM Mono', ui-monospace, monospace;
        font-size: 10px;
        font-weight: 500;
        padding: 3px 8px;
        border-radius: 4px;
        letter-spacing: 0.5px;
        white-space: nowrap;
      }

      /* ── Style 2: Dashed Glow ── */
      .bbox-dashed {
        position: absolute;
        border: 1.5px dashed #ff3d8e;
        border-radius: 6px;
        box-shadow: 0 0 16px rgba(255, 61, 142, 0.15), inset 0 0 16px rgba(255, 61, 142, 0.03);
        animation: bbox-pulse-glow 2.5s ease-in-out infinite;
      }
      @keyframes bbox-pulse-glow {
        0%, 100% { box-shadow: 0 0 16px rgba(255,61,142,0.15), inset 0 0 16px rgba(255,61,142,0.03); }
        50%      { box-shadow: 0 0 28px rgba(255,61,142,0.3), inset 0 0 28px rgba(255,61,142,0.06); }
      }
      .bbox-dashed-tag {
        position: absolute;
        bottom: -10px; left: 50%; transform: translateX(-50%);
        background: #ff3d8e;
        color: #fff;
        font-family: 'DM Mono', ui-monospace, monospace;
        font-size: 10px;
        font-weight: 500;
        padding: 2px 10px;
        border-radius: 10px;
        letter-spacing: 0.5px;
        white-space: nowrap;
        box-shadow: 0 2px 12px rgba(255,61,142,0.4);
      }

      /* ── Style 3: SVG Draw-In ── */
      .bbox-svg-wrap { position: absolute; }
      .bbox-svg-inner {
        position: absolute; inset: 0; width: 100%; height: 100%;
        overflow: visible;
      }
      .bbox-svg-corner {
        stroke: #ffb830;
        stroke-width: 2.5;
        stroke-linecap: round;
        fill: none;
        stroke-dasharray: 300;
        stroke-dashoffset: 300;
        animation: bbox-draw-in 0.8s ease forwards;
      }
      @keyframes bbox-draw-in {
        to { stroke-dashoffset: 0; }
      }
      .bbox-svg-dot {
        fill: #ffb830;
        animation: bbox-blink 1.6s ease-in-out infinite;
      }
      @keyframes bbox-blink {
        0%, 100% { opacity: 1; } 50% { opacity: 0.3; }
      }
      .bbox-svg-tag {
        position: absolute;
        top: -1px; right: -1px;
        background: #ffb830;
        color: #000;
        font-family: 'DM Mono', ui-monospace, monospace;
        font-size: 10px;
        font-weight: 500;
        padding: 4px 8px;
        border-radius: 0 0 0 6px;
        letter-spacing: 0.5px;
        white-space: nowrap;
      }
      .bbox-svg-conf {
        font-weight: 400;
        opacity: 0.6;
        margin-left: 4px;
      }

      /* ── Style 4: Gradient Border ── */
      .bbox-gradient-wrap {
        position: absolute;
      }
      .bbox-gradient {
        position: absolute;
        inset: 0;
        border-radius: 8px;
        border: 2px solid transparent;
        background: linear-gradient(135deg, #8b5cf6, #3b82f6, #00e5cc) border-box;
        background-size: 300% 300%;
        animation: bbox-gradient-shift 4s ease infinite;
        -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
        mask-composite: exclude;
      }
      @keyframes bbox-gradient-shift {
        0%, 100% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
      }
      .bbox-gradient-tag {
        position: absolute;
        top: 8px; left: 8px;
        background: linear-gradient(135deg, #8b5cf6, #3b82f6);
        color: #fff;
        font-family: 'DM Mono', ui-monospace, monospace;
        font-size: 10px;
        font-weight: 500;
        padding: 3px 8px;
        border-radius: 4px;
        letter-spacing: 0.5px;
        white-space: nowrap;
      }

      /* ── Style 5: Frosted Glass ── */
      .bbox-frost {
        position: absolute;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.35);
      }
      .bbox-frost-tag {
        position: absolute;
        top: -14px; left: 12px;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        background: rgba(0,0,0,0.35);
        border: 1px solid rgba(255,255,255,0.15);
        color: #fff;
        font-family: 'DM Mono', ui-monospace, monospace;
        font-size: 10px;
        font-weight: 500;
        padding: 3px 10px;
        border-radius: 6px;
        letter-spacing: 0.5px;
        white-space: nowrap;
        display: flex; align-items: center; gap: 6px;
      }
      .bbox-frost-status {
        width: 5px; height: 5px;
        background: #00e5cc;
        border-radius: 50%;
        box-shadow: 0 0 6px #00e5cc;
        display: inline-block;
      }
    </style>
  </head>
  <body class="main-body bg-gray-50 dark:bg-gray-900 antialiased">
    {@inner_content}
  </body>
</html>
